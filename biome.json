{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": {
    "includes": ["**/*", "!!**/node_modules", "!!**/dist", "!!**/coverage"]
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "bracketSpacing": true
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      "correctness": {
        "noUnusedVariables": "error",
        "noUndeclaredVariables": "error"
      },

      "style": {
        "useConst": "error"
      },

      "suspicious": {
        "noConsole": "warn"
      }
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    },

    "globals": ["Bun"]
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "indentScriptAndStyle": true
    }
  },

  "overrides": [
    {
      "includes": ["**/*.vue", "src/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      },
      "javascript": {
        "globals": ["window", "document", "fetch"]
      }
    },
    {
      "includes": ["bunfig.toml", "scripts/**/*.ts", "**/*.bun.ts"],
      "javascript": {
        "globals": ["Bun", "process"]
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      },
      "javascript": {
        "globals": ["Bun", "describe", "it", "expect"]
      }
    }
  ]
}
